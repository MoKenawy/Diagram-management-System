// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Replace with your actual database provider if different
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  ENGINEER
  DC
  MANAGER
  ADMIN
}

enum FileFormat {
  PDF
  JPEG
  PNG
  SVG
  DWG
}

enum TargetType {
  USER
  DEPARTMENT
}

enum AccessLevel {
  VIEW
  EDIT
  ADMIN
}

enum AccessPolicy {
  ALLOW
  DENY
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum SyncStatus {
  SUCCESS
  FAILED
  NEVER
}

// ---------------------------------------------------------
// MODELS
// ---------------------------------------------------------

model Department {
  id             String     @id @default(cuid())
  nameAr   String
  nameEn   String
  code     String    @unique
  isActive Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  users    User[]
  diagrams Diagram[]
}

model User {
  id                  String     @id @default(cuid())
  username            String    @unique
  fullName            String
  email               String?
  passwordHash        String
  role                Role
  departmentId        String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLogin           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  department          Department?     @relation(fields: [departmentId], references: [id])
  uploadedVersions    DiagramVersion[]
  grantedAccesses     DiagramAccess[] @relation("AccessGrantedBy")
  auditLogs           AuditLog[]
  triggeredBackups    BackupRecord[]
  updatedConfigs      SystemConfig[]
}

model Diagram {
  id             String     @id @default(cuid())
  title            String
  description      String?
  departmentId     String
  currentVersionId String?      // Plain String, NOT a FK relation (handled in application logic)
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  // Relations
  department       Department       @relation(fields: [departmentId], references: [id])
  versions         DiagramVersion[]
  accessRules      DiagramAccess[]
  tags             DiagramTag[]
}

model DiagramVersion {
  id             String     @id @default(cuid())
  diagramId        String
  versionNumber    Int
  revisionLabel    String
  changeSummary    String
  filePath         String
  originalFilename String
  fileFormat       FileFormat
  fileSizeBytes    BigInt
  thumbnailPath    String?
  uploadedById     String
  uploadedAt       DateTime   @default(now())

  // Relations
  diagram          Diagram    @relation(fields: [diagramId], references: [id])
  uploadedBy       User       @relation(fields: [uploadedById], references: [id])

  @@unique([diagramId, versionNumber])
}

model DiagramAccess {
  id          String     @id @default(cuid())
  diagramId   String
  targetType  TargetType
  targetId    String
  accessLevel AccessLevel
  policy      AccessPolicy
  grantedAt   DateTime     @default(now())
  grantedById String

  // Relations
  diagram     Diagram      @relation(fields: [diagramId], references: [id])
  grantedBy   User         @relation("AccessGrantedBy", fields: [grantedById], references: [id])

  @@index([targetType, targetId, diagramId])
}

model DiagramTag {
  id          String     @id @default(cuid())
  diagramId String
  tag       String

  // Relations
  diagram   Diagram @relation(fields: [diagramId], references: [id])

  @@index([tag])
}

model AuditLog {
  id          String     @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  ipAddress  String?
  metadata   Json
  occurredAt DateTime @default(now())

  // Relations
  user       User?    @relation(fields: [userId], references: [id])
}

model BackupRecord {
  id          String     @id @default(cuid())
  filePath      String
  sizeBytes     BigInt
  status        BackupStatus
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  triggeredById String?

  // Relations
  triggeredBy   User?        @relation(fields: [triggeredById], references: [id])
}

model ReplicationTarget {
  id             String     @id @default(cuid())
  host           String
  port           Int        @default(22)
  label          String
  sshUsername    String
  sshKeyPath     String
  isActive       Boolean    @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus SyncStatus @default(NEVER)
  createdAt      DateTime   @default(now())
}

model SystemConfig {
  key          String     @id @default(cuid())
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  // Relations
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}