// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // Replace with your actual database provider if different
}

// ---------------------------------------------------------
// ENUMS
// ---------------------------------------------------------

enum Role {
  ENGINEER
  DC
  MANAGER
  ADMIN
}

enum FileFormat {
  PDF
  JPEG
  PNG
  SVG
  DWG
}

enum TargetType {
  USER
  DEPARTMENT
}

enum AccessPolicy {
  ALLOW
  DENY
}

enum AccessLevel {
  VIEW
  CREATE
  UPDATE
  DELETE
  ADMIN
}

enum BackupStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum SyncStatus {
  SUCCESS
  FAILED
  NEVER
}

// --- NEW ENUMS ---

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  ARCHIVED
}

enum CatalogStatus {
  DRAFT
  PUBLISHED
  REVISED
  ARCHIVED
}

// ---------------------------------------------------------
// MODELS
// ---------------------------------------------------------

model Department {
  id        String   @id @default(cuid())
  nameAr    String
  nameEn    String
  code      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users           User[]
  diagrams        Diagram[]
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  fullName            String
  email               String?
  passwordHash        String
  role                Role
  departmentId        String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLogin           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  department             Department?       @relation(fields: [departmentId], references: [id])
  uploadedVersions       DiagramVersion[]
  grantedAccesses        DiagramAccess[]   @relation("AccessGrantedBy")
  auditLogs              AuditLog[]
  triggeredBackups       BackupRecord[]
  updatedConfigs         SystemConfig[]
  
  // NEW RELATIONS
  managedProjects        Project[]         @relation("ProjectManager")
  createdCatalogs        Catalog[]         @relation("CatalogCreator")
  catalogRevisions       CatalogRevision[] @relation("CatalogRevisionCreator")
  grantedCatalogAccesses CatalogAccess[]   @relation("CatalogAccessGranter")
}

// --- NEW MODEL: LOCATION ---
model Location {
  id          String     @id @default(cuid())
  code        String     @unique
  nameAr      String
  nameEn      String
  parentId    String?
  parent      Location?  @relation("LocationTree", fields: [parentId], references: [id])
  children    Location[] @relation("LocationTree")
  depth       Int        @default(0)
  path        String     @default("/") // materialized path: /cuid1/cuid2/
  coordinates String?
  address     String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  projects    Project[]
  diagrams    Diagram[]

  @@index([parentId])
  @@index([path])
  @@index([depth])
}

// --- NEW MODEL: CATEGORY ---
model Category {
  id        String     @id @default(cuid())
  code      String     @unique
  nameAr    String
  nameEn    String
  parentId  String?
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  depth     Int        @default(0)
  path      String     @default("/")
  icon      String?
  sortOrder Int        @default(0)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  // Relations
  diagrams  DiagramCategory[]

  @@index([parentId])
  @@index([path])
}

// --- NEW MODEL: PROJECT ---
model Project {
  id          String        @id @default(cuid())
  projectCode String        @unique
  name        String        @unique
  nameAr      String?
  description String?
  status      ProjectStatus @default(PLANNING)
  locationId  String?
  location    Location?     @relation(fields: [locationId], references: [id])
  managerId   String?
  manager     User?         @relation("ProjectManager", fields: [managerId], references: [id])
  startDate   DateTime?
  endDate     DateTime?
  clientName  String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Relations
  diagrams    Diagram[]
  catalogs    Catalog[]
}

// --- MODIFIED MODEL: DIAGRAM ---
model Diagram {
  id               String   @id @default(cuid())
  title            String
  description      String?
  departmentId     String
  projectId        String   // NEW: Required relation to Project
  locationId       String?  // NEW: Optional specific location
  currentVersionId String?  // Plain String, NOT a FK relation
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  department       Department        @relation(fields: [departmentId], references: [id])
  project          Project           @relation(fields: [projectId], references: [id]) // NEW
  location         Location?         @relation(fields: [locationId], references: [id]) // NEW
  versions         DiagramVersion[]
  accessRules      DiagramAccess[]
  tags             DiagramTag[]
  categories       DiagramCategory[] // NEW
  catalogs         CatalogDiagram[]  // NEW
}

// --- NEW MODEL: DIAGRAM_CATEGORY (Junction) ---
model DiagramCategory {
  id         String   @id @default(cuid())
  diagramId  String
  diagram    Diagram  @relation(fields: [diagramId], references: [id])
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  assignedAt DateTime @default(now())

  @@unique([diagramId, categoryId])
}

// --- NEW MODEL: CATALOG ---
model Catalog {
  id              String        @id @default(cuid())
  catalogNumber   String        @unique
  title           String
  titleAr         String?
  description     String?
  projectId       String
  project         Project       @relation(fields: [projectId], references: [id])
  revisionNumber  String        @default("Rev-00")
  status          CatalogStatus @default(DRAFT)
  coverDocPath    String?
  compiledPdfPath String?
  createdById     String
  createdBy       User          @relation("CatalogCreator", fields: [createdById], references: [id])
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  diagrams        CatalogDiagram[]
  revisions       CatalogRevision[]
  accessRules     CatalogAccess[]
}

// --- NEW MODEL: CATALOG_DIAGRAM (Junction with Order) ---
model CatalogDiagram {
  id            String   @id @default(cuid())
  catalogId     String
  catalog       Catalog  @relation(fields: [catalogId], references: [id])
  diagramId     String
  diagram       Diagram  @relation(fields: [diagramId], references: [id])
  sequenceOrder Int
  sectionTitle  String?
  addedAt       DateTime @default(now())

  @@unique([catalogId, diagramId])
  @@index([catalogId, sequenceOrder])
}

// --- NEW MODEL: CATALOG_REVISION ---
model CatalogRevision {
  id              String   @id @default(cuid())
  catalogId       String
  catalog         Catalog  @relation(fields: [catalogId], references: [id])
  revisionNumber  String
  changeNotes     String?
  compiledPdfPath String?
  createdById     String
  createdBy       User     @relation("CatalogRevisionCreator", fields: [createdById], references: [id])
  createdAt       DateTime @default(now())
}

// --- NEW MODEL: CATALOG_ACCESS (Matches DiagramAccess) ---
model CatalogAccess {
  id          String       @id @default(cuid())
  catalogId   String
  targetType  TargetType
  targetId    String
  accessLevel AccessLevel
  policy      AccessPolicy
  grantedAt   DateTime     @default(now())
  grantedById String

  // Relations
  catalog   Catalog @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("CatalogAccessGranter", fields: [grantedById], references: [id])

  // One rule per target+action slot — safe to upsert against
  @@unique([catalogId, targetType, targetId, accessLevel])
  @@index([targetType, targetId, catalogId])
}


// ---------------------------------------------------------
// EXISTING UNCHANGED MODELS
// ---------------------------------------------------------

model DiagramVersion {
  id               String     @id @default(cuid())
  diagramId        String
  versionNumber    Int
  revisionLabel    String
  changeSummary    String
  filePath         String
  originalFilename String
  fileFormat       FileFormat
  fileSizeBytes    BigInt
  thumbnailPath    String?
  uploadedById     String
  uploadedAt       DateTime   @default(now())

  // Relations
  diagram          Diagram    @relation(fields: [diagramId], references: [id])
  uploadedBy       User       @relation(fields: [uploadedById], references: [id])

  @@unique([diagramId, versionNumber])
}

model DiagramAccess {
  id          String       @id @default(cuid())
  diagramId   String
  targetType  TargetType
  targetId    String
  accessLevel AccessLevel
  policy      AccessPolicy
  grantedAt   DateTime     @default(now())
  grantedById String

  // Relations
  diagram   Diagram @relation(fields: [diagramId], references: [id], onDelete: Cascade)
  grantedBy User    @relation("AccessGrantedBy", fields: [grantedById], references: [id])

  @@unique([diagramId, targetType, targetId, accessLevel])
  @@index([targetType, targetId, diagramId])
}

model DiagramTag {
  id        String  @id @default(cuid())
  diagramId String
  tag       String

  // Relations
  diagram   Diagram @relation(fields: [diagramId], references: [id])

  @@index([tag])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  targetType String?
  targetId   String?
  ipAddress  String?
  metadata   Json
  occurredAt DateTime @default(now())

  // Relations
  user       User?    @relation(fields: [userId], references: [id])
}

model BackupRecord {
  id            String       @id @default(cuid())
  filePath      String
  sizeBytes     BigInt
  status        BackupStatus
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  triggeredById String?

  // Relations
  triggeredBy   User?        @relation(fields: [triggeredById], references: [id])
}

model ReplicationTarget {
  id             String     @id @default(cuid())
  host           String
  port           Int        @default(22)
  label          String
  sshUsername    String
  sshKeyPath     String
  isActive       Boolean    @default(true)
  lastSyncAt     DateTime?
  lastSyncStatus SyncStatus @default(NEVER)
  createdAt      DateTime   @default(now())
}

model SystemConfig {
  key         String   @id @default(cuid())
  value       String
  updatedAt   DateTime @updatedAt
  updatedById String?

  // Relations
  updatedBy   User?    @relation(fields: [updatedById], references: [id])
}